# ==============================================================================
# Hadeel Baroud Portfolio — Environment Variables Configuration
# ==============================================================================

# Server-side Web3Forms API Access Key (Required for Contact Form dispatch)
# CRITICAL SECURITY NOTE: Never prefix with NEXT_PUBLIC_ to prevent leaking the secret into client bundles.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Base URL for OpenGraph, Twitter Cards, Sitemap and Canonical URL resolution
NEXT_PUBLIC_APP_URL=https://hadeel-portfolio.vercel.app

# Environment Mode (development | test | production)
NODE_ENV=development
